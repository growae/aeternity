{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "GenericSignedTx": {
      "type": "object",
      "properties": {
        "tx": {
          "$ref": "#/definitions/GenericTx"
        },
        "block_height": {
          "$ref": "#/definitions/TxBlockHeight"
        },
        "block_hash": {
          "$ref": "#/definitions/EncodedHash"
        },
        "hash": {
          "$ref": "#/definitions/EncodedHash"
        },
        "encoded_tx": {
          "$ref": "#/definitions/EncodedByteArray"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EncodedValue"
          }
        }
      },
      "required": [
        "tx",
        "block_height",
        "block_hash",
        "hash"
      ]
    },
    "EncodedValue": {
      "type": "string"
    },
    "EncodedByteArray": {
      "type": "string"
    },
    "EncodedHash": {
      "type": "string"
    },
    "TxBlockHeight": {
      "type": "integer",
      "minimum": -1,
      "maximum": 18446744073709551615
    },
    "GenericTx": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/UInt32"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "type"
      ]
    },
    "UInt32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "GenericTxs": {
      "type": "object",
      "properties": {
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GenericSignedTx"
          }
        }
      },
      "required": [
        "transactions"
      ]
    },
    "TxInfoObject": {
      "type": "object",
      "properties": {
        "call_info": {
          "$ref": "#/definitions/ContractCallObject"
        },
        "ga_info": {
          "$ref": "#/definitions/GAObject"
        },
        "tx_info": {
          "type": "string"
        }
      }
    },
    "GAObject": {
      "type": "object",
      "properties": {
        "caller_id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "height": {
          "$ref": "#/definitions/UInt64"
        },
        "gas_price": {
          "$ref": "#/definitions/UInt"
        },
        "gas_used": {
          "$ref": "#/definitions/UInt64"
        },
        "return_value": {
          "$ref": "#/definitions/EncodedByteArray"
        },
        "return_type": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "inner_object": {
          "$ref": "#/definitions/TxInfoObject"
        }
      },
      "required": [
        "caller_id",
        "height",
        "gas_price",
        "gas_used",
        "return_value",
        "return_type"
      ]
    },
    "UInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "UInt": {
      "type": "integer",
      "minimum": 0
    },
    "EncodedPubkey": {
      "type": "string"
    },
    "ContractCallObject": {
      "type": "object",
      "properties": {
        "caller_id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "caller_nonce": {
          "$ref": "#/definitions/UInt64"
        },
        "height": {
          "$ref": "#/definitions/UInt64"
        },
        "contract_id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "gas_price": {
          "$ref": "#/definitions/UInt"
        },
        "gas_used": {
          "$ref": "#/definitions/UInt64"
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Event"
          }
        },
        "return_value": {
          "$ref": "#/definitions/EncodedByteArray"
        },
        "return_type": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "revert"
          ]
        }
      },
      "required": [
        "caller_id",
        "caller_nonce",
        "height",
        "contract_id",
        "gas_price",
        "gas_used",
        "log",
        "return_value",
        "return_type"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UInt"
          }
        },
        "data": {
          "$ref": "#/definitions/EncodedByteArray"
        }
      },
      "required": [
        "address",
        "topics",
        "data"
      ]
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "balance": {
          "$ref": "#/definitions/UInt"
        },
        "nonce": {
          "$ref": "#/definitions/UInt64"
        },
        "payable": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "basic",
            "generalized"
          ]
        },
        "contract_id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "auth_fun": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "balance",
        "nonce"
      ]
    },
    "PoI": {
      "type": "object",
      "properties": {
        "poi": {
          "$ref": "#/definitions/EncodedByteArray"
        }
      },
      "required": [
        "poi"
      ]
    },
    "ByteCode": {
      "type": "object",
      "properties": {
        "bytecode": {
          "$ref": "#/definitions/EncodedByteArray"
        }
      },
      "required": [
        "bytecode"
      ]
    },
    "ContractObject": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "owner_id": {
          "$ref": "#/definitions/EncodedPubkey"
        },
        "vm_version": {
          "$ref": "#/definitions/UInt16"
        },
        "abi_version": {
          "$ref": "#/definitions/UInt16"
        },
        "active": {
          "type": "boolean"
        },
        "referrer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EncodedPubkey"
          }
        },
        "deposit": {
          "$ref": "#/definitions/UInt64"
        }
      },
      "required": [
        "id",
        "owner_id",
        "vm_version",
        "abi_version",
        "active",
        "referrer_ids",
        "deposit"
      ]
    },
    "UInt16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "operations": {
    "GetMicroBlockTransactionsByHash": {
      "$ref": "#/definitions/GenericTxs"
    },
    "GetMicroBlockTransactionByHashAndIndex": {
      "$ref": "#/definitions/GenericSignedTx"
    },
    "GetTransactionByHash": {
      "$ref": "#/definitions/GenericSignedTx"
    },
    "GetTransactionInfoByHash": {
      "$ref": "#/definitions/TxInfoObject"
    },
    "GetAccountByPubkey": {
      "$ref": "#/definitions/Account"
    },
    "GetAccountByPubkeyAndHash": {
      "$ref": "#/definitions/Account"
    },
    "GetAccountByPubkeyAndHeight": {
      "$ref": "#/definitions/Account"
    },
    "GetAccountNextNonce": {
      "type": "object",
      "properties": {
        "next_nonce": {
          "type": "integer"
        }
      }
    },
    "GetPendingAccountTransactionsByPubkey": {
      "$ref": "#/definitions/GenericTxs"
    },
    "GetContract": {
      "$ref": "#/definitions/ContractObject"
    },
    "GetContractCode": {
      "$ref": "#/definitions/ByteCode"
    },
    "GetContractPoI": {
      "$ref": "#/definitions/PoI"
    }
  }
}
